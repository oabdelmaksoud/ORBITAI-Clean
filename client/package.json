{
  "name": "@orbitai/client",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:clean": "pkill -f vite 2>/dev/null || true && sleep 1 && vite",
    "dev:backend": "cd server && npm run dev",
    "dev:all": "concurrently -n \"Frontend,Backend\" -c \"blue,green\" \"npm run dev\" \"npm run dev:backend\"",
    "dev:all:with-docker": "concurrently -n \"Docker,Frontend,Backend\" -c \"yellow,blue,green\" \"docker-compose -f server/docker-compose.yml up\" \"npm run dev\" \"npm run dev:backend\"",
    "share": "bash scripts/share.sh",
    "build": "vite build",
    "preview": "vite preview",
    "validate:exports": "node --loader ts-node/esm scripts/validate-exports.ts || node --experimental-loader ts-node/esm scripts/validate-exports.ts || echo 'Note: Install ts-node to run validation: npm install --save-dev ts-node'",
    "prebuild": "npm run validate:exports || true",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:debug": "playwright test --debug",
    "lint": "eslint . --ext .ts,.tsx --max-warnings 0 || true"
  },
  "dependencies": {
    "@craftjs/core": "^0.2.12",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@e2b/code-interpreter": "1.0.4",
    "@google/genai": "^1.30.0",
    "@monaco-editor/react": "^4.7.0",
    "@orbitai/shared": "*",
    "@react-oauth/google": "^0.13.5",
    "@react-three/drei": "^9.122.0",
    "@react-three/fiber": "^8.18.0",
    "@types/prismjs": "^1.26.6",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@types/three": "^0.181.0",
    "@types/uuid": "^10.0.0",
    "@webcontainer/api": "^1.6.4",
    "axios": "^1.16.1",
    "framer-motion": "^11.18.2",
    "grapesjs": "^0.22.16",
    "grapesjs-blocks-basic": "^1.0.2",
    "grapesjs-plugin-export": "^1.0.12",
    "grapesjs-plugin-forms": "^2.0.6",
    "grapesjs-preset-webpage": "^1.0.3",
    "grapesjs-tabs": "^1.0.6",
    "grapesjs-tooltip": "^0.1.8",
    "grapesjs-touch": "^0.1.1",
    "i18next": "^25.7.1",
    "i18next-browser-languagedetector": "^8.2.1",
    "i18next-http-backend": "^3.0.2",
    "jszip": "^3.10.1",
    "lucide-react": "^0.554.0",
    "mermaid": "^11.15.0",
    "monaco-editor": "^0.55.1",
    "node-fetch": "^2.7.0",
    "prismjs": "^1.30.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-frame-component": "^5.3.2",
    "react-i18next": "^16.3.5",
    "react-markdown": "^10.1.0",
    "react-quill": "^2.0.0",
    "react-router-dom": "^7.15.1",
    "react-syntax-highlighter": "^16.1.1",
    "remark-gfm": "4.0.1",
    "socket.io-client": "^4.8.3",
    "three": "^0.184.0",
    "uuid": "^13.0.0",
    "xterm": "^5.3.0",
    "xterm-addon-fit": "^0.8.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@playwright/test": "^1.60.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.14.0",
    "@types/react-window": "^1.8.8",
    "@vitejs/plugin-react": "^5.0.0",
    "@vitest/ui": "^4.1.7",
    "autoprefixer": "^10.5.0",
    "concurrently": "^8.2.2",
    "eslint": "^9.39.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "jest": "^30.4.2",
    "jsdom": "^27.2.0",
    "postcss": "^8.5.6",
    "react-window": "^1.8.10",
    "supertest": "^7.2.2",
    "tailwindcss": "^3.4.18",
    "terser": "^5.48.0",
    "ts-jest": "^29.4.11",
    "ts-node": "^10.9.2",
    "typescript": "~5.8.2",
    "typescript-eslint": "^8.60.0",
    "vite": "^5.4.21",
    "vitest": "^4.0.14"
  },
  "overrides": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  }
}
