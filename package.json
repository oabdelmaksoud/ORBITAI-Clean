{
    "name": "orbitai-monorepo",
    "version": "1.0.0",
    "private": true,
    "workspaces": [
        "client",
        "server",
        "shared"
    ],
    "scripts": {
        "dev:client": "npm run dev --workspace=client",
        "dev:server": "npm run dev --workspace=server",
        "dev": "npx concurrently \"npm run dev:client\" \"npm run dev:server\"",
        "build": "npm run build --workspaces",
        "build:prod": "npm run clean && npm run build:shared && npm run build:client && npm run build:server",
        "build:shared": "cd shared && npm run build",
        "build:client": "npm run build --workspace=client",
        "build:server": "npm run build --workspace=server",
        "clean": "rm -rf client/dist server/dist shared/dist",
        "test": "npm run test --workspaces",
        "install:all": "npm install",
        "start:prod": "npm run start --workspace=server",
        "preview:client": "npm run preview --workspace=client"
    },
    "devDependencies": {
        "concurrently": "^8.2.2"
    }
}