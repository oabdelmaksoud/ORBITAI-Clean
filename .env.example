# Server Configuration
NODE_ENV=development
PORT=3001
HOST=0.0.0.0

# Database
MONGODB_URI=mongodb://localhost:27017/orbitai
MONGODB_TEST_URI=mongodb://localhost:27017/orbitai-test
REDIS_URL=redis://localhost:6379

# JWT Authentication
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRE=7d

# GitHub OAuth Integration
GITHUB_CLIENT_ID=your-github-oauth-client-id
GITHUB_CLIENT_SECRET=your-github-oauth-client-secret
GITHUB_REDIRECT_URI=http://localhost:3001/api/integrations/github/callback

# AI API Keys (Optional)
OPENAI_API_KEY=sk-your-openai-api-key
ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key
GEMINI_API_KEY=your-gemini-api-key
E2B_API_KEY=your-e2b-sandbox-api-key

# Email Configuration (Optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-specific-password
EMAIL_FROM=OrbitAI <noreply@orbitai.com>

# Frontend URL
CLIENT_URL=http://localhost:5173

# Session Configuration
SESSION_SECRET=your-session-secret-change-this-in-production

# File Upload (Optional)
MAX_FILE_SIZE=10485760
UPLOAD_DIR=./uploads

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Logging
LOG_LEVEL=info
LOG_FORMAT=json

# CORS Configuration
CORS_ORIGIN=http://localhost:5173

# Health Check
HEALTH_CHECK_PORT=3001
HEALTH_CHECK_PATH=/health

# Feature Flags
ENABLE_AI_GENERATION=true
ENABLE_CODE_EXECUTION=true
ENABLE_INTEGRATIONS=true
ENABLE_WORKSPACE_BILLING=false

# Cache Configuration
CACHE_TTL=3600
CACHE_CHECK_PERIOD=600

# WebSocket Configuration
WS_HEARTBEAT_INTERVAL=30000
WS_HEARTBEAT_TIMEOUT=60000

# Monitoring (Optional)
SENTRY_DSN=your-sentry-dsn
ANALYTICS_ID=your-analytics-id
