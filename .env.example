# ============================================================
# OrbitAI Environment Variables
# Copy this file to .env and fill in your values.
# Variables marked REQUIRED must be set before starting.
# ============================================================

# ── Server ───────────────────────────────────────────────────
NODE_ENV=development
PORT=3001
HOST=0.0.0.0
FRONTEND_URL=http://localhost:5173

# ── Database ─────────────────────────────────────────────────
# REQUIRED in production
MONGODB_URI=mongodb://localhost:27017/orbitai
MONGODB_TEST_URI=mongodb://localhost:27017/orbitai-test
# REQUIRED in production (used in docker-compose)
MONGO_USERNAME=orbitai
MONGO_PASSWORD=change-this-password
MONGO_ROOT_USERNAME=root
MONGO_ROOT_PASSWORD=change-this-root-password

# ── Redis ─────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379
# REQUIRED in production (used in docker-compose)
REDIS_PASSWORD=change-this-redis-password

# ── Authentication ────────────────────────────────────────────
# REQUIRED — minimum 32 characters, no placeholder values in production
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=7d

# REQUIRED in production — 32+ char random string for encrypting stored API keys
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
API_KEY_ENCRYPTION_KEY=your-32-character-encryption-key-here

# Share link signing (falls back to JWT_SECRET if unset, but set explicitly in production)
SHARE_LINK_SECRET=your-share-link-secret-change-this-in-production

# ── Session ───────────────────────────────────────────────────
SESSION_SECRET=your-session-secret-change-this-in-production

# ── CORS ──────────────────────────────────────────────────────
# Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:5173
CORS_CREDENTIALS=true

# ── GitHub OAuth ──────────────────────────────────────────────
GITHUB_CLIENT_ID=your-github-oauth-client-id
GITHUB_CLIENT_SECRET=your-github-oauth-client-secret
GITHUB_REDIRECT_URI=http://localhost:3001/api/integrations/github/callback
# Personal access token for GitHub-based cloud deployments (optional)
GITHUB_TOKEN=your-github-personal-access-token

# ── AI API Keys (Optional) ────────────────────────────────────
# Prefer storing keys via Admin Console → Settings → API Keys (encrypted in DB).
# These env vars are used as fallback only for backward compatibility.
OPENAI_API_KEY=sk-your-openai-api-key
ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key
GEMINI_API_KEY=your-gemini-api-key
E2B_API_KEY=your-e2b-sandbox-api-key
DEEPSEEK_API_KEY=your-deepseek-api-key
GROK_API_KEY=your-grok-api-key
MISTRAL_API_KEY=your-mistral-api-key
QWEN_API_KEY=your-qwen-api-key
QWEN_API_BASE_URL=
HUGGING_FACE_API_KEY=your-huggingface-api-key
OPENROUTER_API_KEY=your-openrouter-api-key
GROQ_API_KEY=your-groq-api-key

# ── Vertex AI / Google Cloud (Optional) ───────────────────────
VERTEX_API_KEY=your-vertex-api-key
VERTEX_PROJECT_ID=your-gcp-project-id
VERTEX_LOCATION=us-central1

# ── Azure OpenAI (Optional) ───────────────────────────────────
AZURE_OPENAI_API_KEY=your-azure-openai-api-key
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
AZURE_OPENAI_DEPLOYMENT_NAME=your-deployment-name
AZURE_OPENAI_API_VERSION=2024-02-15-preview

# ── Google Search API (Optional) ──────────────────────────────
GOOGLE_SEARCH_API_KEY=your-google-search-api-key
GOOGLE_SEARCH_ENGINE_ID=your-custom-search-engine-id

# ── LLM Routing ───────────────────────────────────────────────
ENABLE_MULTI_LLM=true
DEFAULT_LLM_PROVIDER=gemini
LLM_ROUTING_STRATEGY=intelligent

# ── Email (Optional) ──────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-specific-password
EMAIL_FROM=OrbitAI <noreply@orbitai.com>

# ── Slack Integration (Optional) ──────────────────────────────
SLACK_CLIENT_ID=your-slack-client-id
SLACK_CLIENT_SECRET=your-slack-client-secret
SLACK_BOT_TOKEN=xoxb-your-slack-bot-token
SLACK_SIGNING_SECRET=your-slack-signing-secret
SLACK_REDIRECT_URI=http://localhost:3001/api/integrations/slack/callback

# ── Google Drive Integration (Optional) ───────────────────────
GOOGLE_CLIENT_ID=your-google-oauth-client-id
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret
GOOGLE_REDIRECT_URI=http://localhost:3001/api/integrations/google-drive/callback

# ── Microsoft Teams Integration (Optional) ────────────────────
MSTEAMS_CLIENT_ID=your-msteams-azure-app-client-id
MSTEAMS_CLIENT_SECRET=your-msteams-azure-app-client-secret
AZURE_CLIENT_ID=your-azure-client-id
AZURE_CLIENT_SECRET=your-azure-client-secret

# ── Cloud Deployment (Optional) ───────────────────────────────
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
AWS_REGION=us-east-1
GCP_PROJECT_ID=your-gcp-project-id
GCP_SERVICE_ACCOUNT_KEY=your-base64-encoded-service-account-json
VERCEL_API_TOKEN=your-vercel-api-token
RAILWAY_API_TOKEN=your-railway-api-token
RENDER_API_KEY=your-render-api-key

# ── Neo4j Graph Database (Optional) ──────────────────────────
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your-neo4j-password

# ── Weaviate Vector Database (Optional) ──────────────────────
WEAVIATE_URL=http://localhost:8080
WEAVIATE_API_KEY=your-weaviate-api-key
WEAVIATE_CLASS_NAME=OrbitAIArtifact

# ── Pipecat Voice Service (Optional) ─────────────────────────
PIPECAT_HOST=localhost
PIPECAT_PORT=8000
PIPECAT_ENABLED=false

# ── File Upload ───────────────────────────────────────────────
MAX_FILE_SIZE=10485760
UPLOAD_DIR=./uploads

# ── Rate Limiting ─────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ── Logging ───────────────────────────────────────────────────
LOG_LEVEL=info
LOG_FORMAT=json

# ── WebSocket ─────────────────────────────────────────────────
WS_HEARTBEAT_INTERVAL=30000
WS_HEARTBEAT_TIMEOUT=60000

# ── Feature Flags ─────────────────────────────────────────────
ENABLE_AI_GENERATION=true
ENABLE_CODE_EXECUTION=true
ENABLE_INTEGRATIONS=true
ENABLE_WORKSPACE_BILLING=false

# ── Cache ─────────────────────────────────────────────────────
CACHE_TTL=3600
CACHE_CHECK_PERIOD=600

# ── Monitoring (Optional) ─────────────────────────────────────
SENTRY_DSN=your-sentry-dsn
ANALYTICS_ID=your-analytics-id
