# Server Configuration
NODE_ENV=development
PORT=3001
HOST=0.0.0.0

# Database
MONGODB_URI=mongodb://localhost:27017/orbitai
MONGODB_TEST_URI=mongodb://localhost:27017/orbitai-test
REDIS_URL=redis://localhost:6379

# JWT Authentication
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRE=7d

# GitHub OAuth Integration
GITHUB_CLIENT_ID=your-github-oauth-client-id
GITHUB_CLIENT_SECRET=your-github-oauth-client-secret
GITHUB_REDIRECT_URI=http://localhost:3001/api/integrations/github/callback

# AI API Keys (Optional)
OPENAI_API_KEY=sk-your-openai-api-key
ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key
GEMINI_API_KEY=your-gemini-api-key
E2B_API_KEY=your-e2b-sandbox-api-key

# Email Configuration (Optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-specific-password
EMAIL_FROM=OrbitAI <noreply@orbitai.com>

# Frontend URL
CLIENT_URL=http://localhost:5173
APP_URL=http://localhost:5173

# Session Configuration
SESSION_SECRET=your-session-secret-change-this-in-production

# File Upload (Optional)
MAX_FILE_SIZE=10485760
UPLOAD_DIR=./uploads

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Logging
LOG_LEVEL=info
LOG_FORMAT=json

# CORS Configuration
CORS_ORIGIN=http://localhost:5173

# Health Check
HEALTH_CHECK_PORT=3001
HEALTH_CHECK_PATH=/health

# Feature Flags
ENABLE_AI_GENERATION=true
ENABLE_CODE_EXECUTION=true
ENABLE_INTEGRATIONS=true
ENABLE_WORKSPACE_BILLING=false

# Cache Configuration
CACHE_TTL=3600
CACHE_CHECK_PERIOD=600

# WebSocket Configuration
WS_HEARTBEAT_INTERVAL=30000
WS_HEARTBEAT_TIMEOUT=60000

# Monitoring (Optional)
SENTRY_DSN=your-sentry-dsn
ANALYTICS_ID=your-analytics-id

# Neo4j Graph Database (Optional)
# Required for knowledge graph features. Install neo4j-driver: npm install neo4j-driver
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your-neo4j-password

# Weaviate Vector Database (Optional)
# Required for vector search features. Install weaviate-client: npm install weaviate-client
WEAVIATE_URL=http://localhost:8080
WEAVIATE_API_KEY=your-weaviate-api-key
WEAVIATE_CLASS_NAME=KnowledgeBase

# Pipecat Voice Service (Optional)
# Requires a separately deployed Python Pipecat service. See DEPLOYMENT.md for setup.
PIPECAT_HOST=localhost
PIPECAT_PORT=8000
PIPECAT_ENABLED=false

# Microsoft Teams Integration (Optional)
# Register an app at https://portal.azure.com → Azure Active Directory → App registrations
MSTEAMS_CLIENT_ID=your-msteams-azure-app-client-id
MSTEAMS_CLIENT_SECRET=your-msteams-azure-app-client-secret
AZURE_CLIENT_ID=your-azure-client-id
AZURE_CLIENT_SECRET=your-azure-client-secret

# Slack Integration (Optional)
# Create a Slack app at https://api.slack.com/apps
SLACK_CLIENT_ID=your-slack-client-id
SLACK_CLIENT_SECRET=your-slack-client-secret
SLACK_BOT_TOKEN=xoxb-your-slack-bot-token
SLACK_SIGNING_SECRET=your-slack-signing-secret

# AWS Deployment (Optional)
# Required for deploying projects to AWS. Grant the IAM user ECS/ECR/S3 permissions.
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
AWS_REGION=us-east-1

# GCP Deployment (Optional)
# Required for deploying projects to Google Cloud. Grant the service account Cloud Run / GKE permissions.
GCP_PROJECT_ID=your-gcp-project-id
GCP_SERVICE_ACCOUNT_KEY=your-base64-encoded-service-account-json

# Vercel Deployment (Optional)
VERCEL_API_TOKEN=your-vercel-api-token

# Railway Deployment (Optional)
RAILWAY_API_TOKEN=your-railway-api-token

# Render Deployment (Optional)
RENDER_API_KEY=your-render-api-key

# GitHub Token (Optional — used for GitHub-based cloud deployments)
GITHUB_TOKEN=your-github-personal-access-token

